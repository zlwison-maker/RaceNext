.page {
  min-height: 100vh;
  padding: 24rpx 40rpx 64rpx;
}

.brand-header {
  padding: 8rpx 0 40rpx;
}

.brand-logo {
  display: block;
  width: 129rpx;
  height: 40rpx;
}

.brand-tagline {
  display: block;
  margin-top: 16rpx;
  color: #767676;
  font-size: 26rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.page-state {
  padding: 88rpx 0;
}

.page-state--error {
  padding-top: 72rpx;
}

.state-title,
.state-copy {
  display: block;
}

.state-title {
  color: #222222;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
}

.state-copy {
  margin-top: 8rpx;
  color: #8a8a8a;
  font-size: 26rpx;
  line-height: 1.5;
}

.retry-button {
  display: inline-block;
  margin: 32rpx 0 0;
  padding: 0 32rpx;
  border-radius: 6rpx;
  background: #111111;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 72rpx;
}

.retry-button::after {
  border: 0;
}

.race-card {
  width: 100%;
}

.race-card + .race-card {
  margin-top: 32rpx;
}

.race-card--pressed {
  opacity: 0.88;
}

.race-cover {
  position: relative;
  width: 100%;
  height: 377rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #deded9;
}

.race-cover__image,
.race-cover__fallback {
  width: 100%;
  height: 100%;
}

.race-cover__image {
  display: block;
}

.race-cover__fallback {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fallback-logo {
  width: 116rpx;
  opacity: 0.35;
}

.race-scrim {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 64%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.27) 52%, rgba(0, 0, 0, 0) 100%);
}

.race-content {
  position: absolute;
  right: 28rpx;
  bottom: 26rpx;
  left: 28rpx;
}

.race-name,
.race-meta {
  display: block;
}

.race-name {
  display: -webkit-box;
  overflow: hidden;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.32;
  letter-spacing: -0.3rpx;
  text-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.2);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.race-meta {
  margin-top: 10rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.84);
  font-size: 26rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  text-shadow: 0 1rpx 5rpx rgba(0, 0, 0, 0.18);
  white-space: nowrap;
}
