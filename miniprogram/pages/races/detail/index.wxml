<view class="detail-page">
  <view wx:if="{{loadState === 'loading'}}" class="page-state">
    <text class="state-title">正在加载赛事信息…</text>
  </view>

  <view wx:elif="{{loadState === 'error'}}" class="page-state page-state--error">
    <text class="state-title">赛事信息加载失败</text>
    <text class="state-copy">请稍后再试</text>
    <button class="retry-button" bindtap="handleRetry">重新加载</button>
  </view>

  <block wx:elif="{{detail}}">
    <view class="hero">
      <image
        wx:if="{{detail.heroImage && !heroImageFailed}}"
        class="hero-image"
        src="{{detail.heroImage}}"
        mode="{{detail.heroMode}}"
        style="object-position: {{detail.heroFocalPoint}};"
        binderror="handleHeroImageError"
        aria-label="{{detail.name}}赛事图片"
      />
      <view wx:else class="hero-fallback">
        <image
          class="fallback-logo"
          src="/assets/brand/next-logo-mini-header-black.png"
          mode="widthFix"
          aria-label="RaceNext"
        />
      </view>
    </view>

    <view class="detail-content">
      <view class="title-section">
        <view class="race-title">{{detail.name}}</view>
      </view>

      <view class="edition-meta">
        <text class="edition-meta__primary">{{detail.dateDisplay}}</text>
        <text class="edition-meta__primary">{{detail.locationDisplay}}</text>
        <text wx:if="{{detail.summaryDisplay}}" class="edition-meta__summary">{{detail.summaryDisplay}}</text>
        <text wx:if="{{detail.registrationDisplay}}" class="edition-meta__registration">
          {{detail.registrationDisplay}}
        </text>
      </view>

      <view wx:if="{{detail.selectedCategory}}" class="category-facts">
        <view wx:if="{{detail.showCategorySelector}}" class="category-section">
          <text class="category-heading">组别</text>

          <view class="category-selector">
            <view
              wx:for="{{detail.categories}}"
              wx:key="categoryId"
              class="category-option {{item.categoryId === detail.selectedCategoryId ? 'category-option--active' : ''}}"
              data-category-id="{{item.categoryId}}"
              bindtap="handleCategoryTap"
              hover-class="category-option--pressed"
              aria-role="button"
            >
              {{item.label}}
            </view>
          </view>

          <view wx:if="{{detail.selectedCategory.coreFacts.length}}" class="core-facts">
            <view
              wx:for="{{detail.selectedCategory.coreFacts}}"
              wx:key="key"
              class="core-fact"
            >
              <text class="core-fact__value">{{item.value}}</text>
              <text class="core-fact__label">{{item.label}}</text>
            </view>
          </view>

          <view wx:if="{{detail.selectedCategory.executionFacts.length}}" class="execution-facts">
            <view
              wx:for="{{detail.selectedCategory.executionFacts}}"
              wx:key="key"
              class="execution-fact"
            >
              <text class="execution-fact__label">{{item.label}}</text>
              <text class="execution-fact__value">{{item.value}}</text>
            </view>
          </view>
        </view>

        <view
          wx:if="{{detail.selectedCategory.coursePointSection}}"
          class="course-points"
        >
          <text class="execution-fact__label course-points__label">
            {{detail.selectedCategory.coursePointSection.title}}
          </text>

          <view class="course-points__list">
            <view
              wx:for="{{detail.selectedCategory.coursePointSection.points}}"
              wx:key="pointId"
              class="course-point course-point--{{item.type}}"
            >
              <text class="course-point__label">{{item.pointLabel}}</text>
              <text class="course-point__line">
                <text class="execution-fact__value course-point__name">{{item.name}}</text>
                <text wx:if="{{item.factsDisplay}}" class="course-point__facts"> · {{item.factsDisplay}}</text>
                <text wx:if="{{item.serviceDisplay}}" class="course-point__services"> · {{item.serviceDisplay}}</text>
              </text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{detail.raceGuide}}" class="race-guide">
        <view class="race-guide__header">
          <text class="race-guide__eyebrow">RACE GUIDE</text>
          <text class="race-guide__title">{{detail.raceGuide.opening.title}}</text>
        </view>

        <view class="race-guide__body race-guide__paragraphs">
          <text
            wx:for="{{detail.raceGuide.opening.body}}"
            wx:key="*this"
            class="race-guide__paragraph"
          >{{item}}</text>
        </view>

        <view class="race-guide__section">
          <text class="race-guide__section-title">{{detail.raceGuide.judgment.title}}</text>
          <view class="race-guide__body race-guide__paragraphs">
            <text
              wx:for="{{detail.raceGuide.judgment.body}}"
              wx:key="*this"
              class="race-guide__paragraph"
            >{{item}}</text>
          </view>
        </view>

        <view class="race-guide__experiences">
          <view
            wx:for="{{detail.raceGuide.experiences}}"
            wx:key="number"
            class="race-guide__experience"
          >
            <text class="race-guide__number">{{item.number}}</text>
            <text class="race-guide__experience-title">{{item.title}}</text>
            <view class="race-guide__body race-guide__paragraphs">
              <text
                wx:for="{{item.body}}"
                wx:for-item="paragraph"
                wx:key="*this"
                class="race-guide__paragraph"
              >{{paragraph}}</text>
              <text wx:if="{{item.conclusion}}" class="race-guide__paragraph race-guide__conclusion">
                {{item.conclusion}}
              </text>
            </view>
          </view>
        </view>

        <view wx:if="{{detail.raceGuide.runnerFit}}" class="race-guide__section">
          <text class="race-guide__section-title">{{detail.raceGuide.runnerFit.title}}</text>
          <text wx:if="{{detail.raceGuide.runnerFit.introduction}}" class="race-guide__introduction">
            {{detail.raceGuide.runnerFit.introduction}}
          </text>
          <view class="race-guide__fit-list">
            <view
              wx:for="{{detail.raceGuide.runnerFit.items}}"
              wx:key="number"
              class="race-guide__fit-item"
            >
              <text class="race-guide__number">{{item.number}}</text>
              <view class="race-guide__fit-content">
                <text class="race-guide__fit-title">{{item.title}}</text>
                <text
                  wx:for="{{item.body}}"
                  wx:for-item="paragraph"
                  wx:key="*this"
                  class="race-guide__fit-copy"
                >{{paragraph}}</text>
              </view>
            </view>
          </view>
        </view>

        <text wx:if="{{detail.raceGuide.closing}}" class="race-guide__closing">
          {{detail.raceGuide.closing}}
        </text>
      </view>

      <view wx:if="{{detail.showRaceStrategy && detail.raceStrategy}}" class="race-strategy">
        <view class="race-strategy__header">
          <text class="race-strategy__eyebrow">{{detail.raceStrategy.eyebrow}}</text>
          <text class="race-strategy__title">{{detail.raceStrategy.title}}</text>
          <text class="race-strategy__scope">{{detail.raceStrategy.scopeNote}}</text>
        </view>

        <view class="race-strategy__items">
          <view
            wx:for="{{detail.raceStrategy.items}}"
            wx:key="number"
            class="race-strategy__item"
          >
            <text class="race-strategy__number">{{item.number}}</text>
            <text class="race-strategy__item-title">{{item.title}}</text>
            <view class="race-strategy__paragraphs">
              <text
                wx:for="{{item.paragraphs}}"
                wx:for-item="paragraph"
                wx:key="text"
                class="race-strategy__paragraph {{paragraph.emphasis ? 'race-strategy__paragraph--emphasis' : ''}}"
              >{{paragraph.text}}</text>
            </view>
          </view>
        </view>

        <text wx:if="{{detail.raceStrategy.closing}}" class="race-strategy__closing">
          {{detail.raceStrategy.closing}}
        </text>
      </view>

    </view>
  </block>
</view>
