.detail-page {
  min-height: 100vh;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.page-state {
  padding: 144rpx 40rpx 80rpx;
}

.page-state--error {
  padding-top: 128rpx;
}

.state-title,
.state-copy {
  display: block;
}

.state-title {
  color: #222222;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
}

.state-copy {
  margin-top: 8rpx;
  color: #8a8a8a;
  font-size: 26rpx;
  line-height: 1.5;
}

.retry-button {
  display: inline-block;
  margin: 32rpx 0 0;
  padding: 0 32rpx;
  border-radius: 6rpx;
  background: #111111;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 72rpx;
}

.retry-button::after {
  border: 0;
}

.hero {
  position: relative;
  width: 100%;
  height: 375rpx;
  overflow: hidden;
  background: #0a1824;
}

.hero-image,
.hero-fallback {
  display: block;
  width: 100%;
  height: 100%;
}

.hero-image--positioned {
  background-repeat: no-repeat;
  background-size: cover;
}

.hero-image__probe {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
}

.hero-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ecece8;
}

.fallback-logo {
  width: 128rpx;
  opacity: 0.34;
}

.detail-content {
  padding: 0 40rpx;
}

.title-section {
  padding-top: 44rpx;
}

.race-title {
  display: -webkit-box;
  max-height: 120rpx;
  overflow: hidden;
  color: #111111;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 60rpx;
  letter-spacing: -0.4rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.edition-meta {
  margin-top: 32rpx;
}

.edition-meta__primary,
.edition-meta__summary,
.edition-meta__registration {
  display: block;
}

.guide-tabs {
  display: flex;
  margin-top: 66rpx;
  border-bottom: 1rpx solid #e9e9e5;
  gap: 48rpx;
}

.guide-tab {
  position: relative;
  padding-bottom: 18rpx;
  color: #8a8a8a;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.guide-tab--active {
  color: #111111;
  font-weight: 600;
}

.guide-tab--active::after {
  position: absolute;
  right: 0;
  bottom: -1rpx;
  left: 0;
  height: 3rpx;
  background: #111111;
  content: "";
}

.edition-meta__primary {
  margin-top: 12rpx;
  color: #2a2a2a;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.edition-meta__primary:first-child {
  margin-top: 0;
}

.edition-meta__summary {
  margin-top: 12rpx;
  color: #2a2a2a;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.edition-meta__registration {
  margin-top: 12rpx;
  color: #8a8a8a;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.category-section {
  margin-top: 64rpx;
}

.category-heading {
  display: block;
  color: #111111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.category-selector-scroll {
  width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  white-space: nowrap;
}

.category-selector {
  display: inline-flex;
  padding-right: 4rpx;
  gap: 36rpx;
}

.category-option {
  position: relative;
  flex: 0 0 auto;
  padding: 0 0 14rpx;
  border-bottom: 3rpx solid transparent;
  color: #8a8a8a;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.category-option--active {
  border-bottom-color: #111111;
  color: #111111;
  font-weight: 600;
}

.category-option--pressed {
  opacity: 0.58;
}

.core-facts-scroll {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
}

.core-facts {
  display: flex;
  padding: 44rpx 0 22rpx;
  white-space: normal;
}

.core-facts--scrollable {
  min-width: 820rpx;
}

.core-facts--scrollable .core-fact {
  min-width: 188rpx;
  flex: 1 0 188rpx;
}

.core-fact {
  min-width: 0;
  flex: 1;
}

.core-fact + .core-fact {
  padding-left: 22rpx;
}

.core-fact__value,
.core-fact__label {
  display: block;
}

.core-fact__value {
  overflow: hidden;
  color: #111111;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 56rpx;
  letter-spacing: -0.4rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.core-fact__label {
  margin-top: 4rpx;
  color: #8a8a8a;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.execution-fact {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0ed;
  align-items: flex-start;
}

.execution-fact__label {
  width: 132rpx;
  flex: 0 0 auto;
  color: #8a8a8a;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.execution-fact__value {
  min-width: 0;
  flex: 1;
  color: #222222;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.race-guide {
  margin-top: 112rpx;
  padding: 0 0 32rpx;
}

.race-guide--tabbed {
  margin-top: 64rpx;
}

.race-guide__eyebrow,
.race-guide__title,
.race-guide__section-title,
.race-guide__paragraph,
.race-guide__number,
.race-guide__experience-title,
.race-guide__introduction,
.race-guide__fit-title,
.race-guide__fit-copy,
.race-guide__closing {
  display: block;
}

.race-guide__eyebrow {
  color: #8a8a8a;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
  letter-spacing: 3.2rpx;
}

.race-guide__title {
  margin-top: 14rpx;
  color: #111111;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 56rpx;
  letter-spacing: -0.3rpx;
}

.race-guide__body {
  color: #3b3b3b;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.race-guide__paragraphs {
  margin-top: 34rpx;
}

.race-guide__paragraph + .race-guide__paragraph {
  margin-top: 24rpx;
}

.race-guide__section {
  margin-top: 88rpx;
}

.race-guide__section-title {
  color: #111111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.race-guide__experiences {
  margin-top: 92rpx;
}

.race-guide__experience + .race-guide__experience {
  margin-top: 84rpx;
}

.race-guide__number {
  color: #9a9a9a;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 36rpx;
  letter-spacing: 1.4rpx;
}

.race-guide__experience-title {
  margin-top: 14rpx;
  color: #111111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.race-guide__conclusion {
  color: #2a2a2a;
  font-weight: 600;
}

.race-guide__introduction {
  margin-top: 24rpx;
  color: #3b3b3b;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.race-guide__fit-list {
  margin-top: 38rpx;
}

.race-guide__fit-item {
  display: flex;
  align-items: flex-start;
}

.race-guide__fit-item + .race-guide__fit-item {
  margin-top: 44rpx;
}

.race-guide__fit-item > .race-guide__number {
  width: 56rpx;
  flex: 0 0 auto;
  padding-top: 5rpx;
}

.race-guide__fit-content {
  min-width: 0;
  flex: 1;
}

.race-guide__fit-title {
  color: #111111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.race-guide__fit-copy {
  margin-top: 12rpx;
  color: #3b3b3b;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.race-guide__fit-copy + .race-guide__fit-copy {
  margin-top: 18rpx;
}

.race-guide__closing {
  margin-top: 88rpx;
  color: #3b3b3b;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.course-points {
  margin-top: 24rpx;
}

.course-points__label,
.course-point__label,
.course-point__name,
.course-point__facts,
.course-point__services {
  display: inline;
}

.accommodation-guide {
  padding: 46rpx 0 32rpx;
}

.accommodation-guide__intro,
.hotel-card__name,
.hotel-card__judgment,
.hotel-card__reason {
  display: block;
}

.accommodation-guide__intro {
  color: #707070;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.hotel-list {
  margin-top: 44rpx;
}

.hotel-card {
  padding: 36rpx 40rpx;
  border: 1rpx solid #e9e9e5;
  border-radius: 16rpx;
  background: #ffffff;
}

.hotel-card--pressed {
  background: #f7f7f4;
  opacity: 0.92;
}

.hotel-card + .hotel-card {
  margin-top: 28rpx;
}

.hotel-card__judgment {
  color: #2f6b45;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.hotel-card__entity {
  display: flex;
  margin-top: 16rpx;
  align-items: flex-start;
  gap: 12rpx;
}

.hotel-card__icon {
  width: 30rpx;
  height: 30rpx;
  margin-top: 7rpx;
  flex-shrink: 0;
}

.hotel-card__name {
  flex: 1;
  min-width: 0;
  color: #2a2a2a;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.hotel-card__reason {
  margin-top: 20rpx;
  color: #707070;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.hotel-card__cta {
  display: inline-flex;
  min-height: 88rpx;
  margin: 12rpx 0 -16rpx -16rpx;
  padding: 0 16rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #111111;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.4;
  text-align: left;
  align-items: center;
  justify-content: flex-start;
}

.share-action {
  position: fixed;
  z-index: 20;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  display: inline-flex;
  width: auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 0;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.82);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1;
  opacity: 1;
  transform: translateX(0);
  transition: transform 250ms cubic-bezier(0.22, 1, 0.36, 1), opacity 240ms ease-out;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.share-action::after {
  border: 0;
}

.share-action--hidden {
  opacity: 0;
  transform: translateX(calc(-100% - 48rpx));
  transition-duration: 200ms;
  pointer-events: none;
}

.share-action--pressed {
  opacity: 0.58;
}

.share-action__icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.share-action__label {
  display: block;
}

.course-points__label {
  display: block;
  width: auto;
  color: #8a8a8a;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.course-points__list {
  margin-top: 8rpx;
}

.course-point {
  display: flex;
  padding: 17rpx 0 18rpx;
  border-bottom: 1rpx solid #f0f0ed;
  align-items: baseline;
}

.course-point__label {
  width: 80rpx;
  flex: 0 0 auto;
  color: #9a9a9a;
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: 0.4rpx;
}

.course-point--finish .course-point__label {
  color: #9a9a9a;
}

.course-point--water_point .course-point__label {
  color: #6f6f6f;
}

.course-point__line {
  display: block;
  min-width: 0;
  flex: 1;
  line-height: 1.5;
}

.race-strategy {
  margin-top: 112rpx;
  padding: 0 0 32rpx;
}

.race-strategy__eyebrow,
.race-strategy__title,
.race-strategy__scope,
.race-strategy__number,
.race-strategy__item-title,
.race-strategy__paragraph,
.race-strategy__closing {
  display: block;
}

.race-strategy__eyebrow {
  color: #8a8a8a;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
  letter-spacing: 3.2rpx;
}

.race-strategy__title {
  margin-top: 14rpx;
  color: #111111;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 56rpx;
  letter-spacing: -0.3rpx;
}

.race-strategy__scope {
  margin-top: 28rpx;
  color: #3b3b3b;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.race-strategy__items {
  margin-top: 88rpx;
}

.race-strategy__item + .race-strategy__item {
  margin-top: 84rpx;
}

.race-strategy__number {
  color: #9a9a9a;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 36rpx;
  letter-spacing: 1.4rpx;
}

.race-strategy__item-title {
  margin-top: 14rpx;
  color: #111111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.race-strategy__paragraphs {
  margin-top: 34rpx;
  color: #3b3b3b;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.race-strategy__paragraph + .race-strategy__paragraph {
  margin-top: 24rpx;
}

.race-strategy__paragraph--emphasis {
  color: #2a2a2a;
  font-weight: 600;
}

.race-strategy__closing {
  margin-top: 88rpx;
  color: #3b3b3b;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.course-point__name {
  font-weight: 400;
}

.course-point__facts {
  color: #676767;
  font-size: 24rpx;
  line-height: 1.5;
}

.course-point__services {
  color: #222222;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
}
