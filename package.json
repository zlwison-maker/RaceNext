{
  "name": "racenext",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "images:share": "node scripts/generateMiniShareImages.mjs",
    "data:poc": "node scripts/dataPoc.ts",
    "data:runchina": "node scripts/connectors/runchinaConnector.ts",
    "data:zuicool": "node scripts/connectors/zuicoolConnector.ts",
    "data:normalize": "node scripts/normalize/normalizeSourceRecords.ts",
    "data:merge-samples": "node scripts/merge/mergeConnectorSamples.ts",
    "data:connectors:poc": "npm run data:runchina && npm run data:zuicool && npm run data:normalize && npm run data:merge-samples",
    "data:future-top100": "node scripts/seed/buildFutureTop100Seed.ts",
    "race:dry-run:no-key": "node scripts/race-update/noKeyDryRunCli.ts",
    "race:extract:real": "node --env-file-if-exists=.env.local scripts/race-update/realExtractionCli.ts",
    "race:pending:list": "node scripts/race-update/pendingCli.ts list",
    "race:pending:approve": "node scripts/race-update/pendingCli.ts approve",
    "race:pending:reject": "node scripts/race-update/pendingCli.ts reject",
    "race:pending:apply": "node scripts/race-update/pendingCli.ts apply",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck:miniprogram": "tsc -p miniprogram/tsconfig.json"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.2",
    "next": "16.3.6",
    "pdf-parse": "2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "miniprogram-api-typings": "5.2.3"
  }
}
